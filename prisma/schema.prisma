generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Species {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  birds     Bird[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ring {
  id         String   @id @default(cuid())
  code       String   @unique
  material   String?
  year       Int?
  isAssigned Boolean  @default(false)
  bird       Bird?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bird {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  speciesId   String
  species     Species     @relation(fields: [speciesId], references: [id])
  ringId      String?     @unique
  ring        Ring?       @relation(fields: [ringId], references: [id])
  price       Int?
  gender      BirdGender  @default(UNKNOWN)
  birthDate   DateTime?
  parentTrah  String?
  description String?
  images      String[]
  status      BirdStatus  @default(AVAILABLE)
  isFeatured  Boolean     @default(false)
  inquiries   InquiryLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model InquiryLog {
  id              String   @id @default(cuid())
  birdId          String
  bird            Bird     @relation(fields: [birdId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String
  customerAddress String?
  waMessageSent   Boolean  @default(false)
  createdAt       DateTime @default(now())
}

enum BirdStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum BirdGender {
  MALE
  FEMALE
  UNKNOWN
}
